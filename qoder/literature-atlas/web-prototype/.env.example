# 复制为 .env.local。PowerContext 的显式文献写入和检索不需要模型 API Key。
POWERCONTEXT_URL=http://127.0.0.1:8017
VITE_POWERCONTEXT_ENDPOINT=/api/context
# 如果已有项目 Scope，可填服务端返回的 ID；留空则按固定幂等键创建。
# POWERCONTEXT_SCOPE_ID=scp_YOUR_SCOPE_ID
# 如 PowerContext Server 开启鉴权，Token 只填在本机服务端，不加 VITE_ 前缀。
# POWERCONTEXT_TOKEN=YOUR_POWERCONTEXT_TOKEN

# 可选：用自己的兼容 OpenAI Chat Completions 的模型服务启用 AI 分类和综合回答。
# 真实模型 Key 只在本机服务端读取；不要提交到 Git。
# AI_BASE_URL=https://YOUR_PROVIDER.example/v1
# AI_MODEL=YOUR_MODEL_NAME
# AI_API_KEY=YOUR_OWN_API_KEY
# VITE_LITERATURE_ASK_ENDPOINT=/api/ask
# VITE_LITERATURE_CLASSIFY_ENDPOINT=/api/classify
