# Default, tested deployment: actual embedded seekdb with durable disk storage.
POWERCONTEXT_SEEKDB_PATH=.echoes-runtime/seekdb
# Alternative: comment out SEEKDB_PATH and use a real OceanBase MySQL tenant.
# POWERCONTEXT_DATABASE_URL=mysql+aoceanbase://USER:PASSWORD@DB_HOST:2881/echoes_dify?charset=utf8mb4
POWERCONTEXT_BASE_URL=http://127.0.0.1:18180
POWERCONTEXT_PORT=18180
POWERCONTEXT_HOST=127.0.0.1
# Required when binding outside loopback; enter the same value in Dify's secret environment variable.
POWERCONTEXT_TOKEN=
# This is a creation idempotency key, NOT the server-assigned Scope ID.
POWERCONTEXT_SCOPE_KEY=dify-echoes-demo
# bootstrap_powercontext.py prints the actual ID to paste here and into Dify.
POWERCONTEXT_SCOPE_ID=
